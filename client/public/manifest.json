{
  "manifest_version": 3,
  "name": "AI Page Assistant",
  "version": "1.0.0",
  "description": "AI-powered page assistant for summaries, Q&A, and translations.",
  "action": {
    "default_title": "AI Page Assistant",
    "default_popup": "index.html",
    "default_icon": "favicon.svg"
  },
  "icons": {
    "48": "favicon.svg",
    "128": "favicon.svg"
  },
  "permissions": ["storage", "tabs", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open AI Page Assistant"
    }
  }
}
