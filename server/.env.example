# Database Configuration (Neon PostgreSQL)
# For Neon, copy your connection string from the Neon Console.
# Both 'postgresql://' and 'postgresql+psycopg://' formats are supported.
# sslmode=require is automatically enforced for Neon connections.
DATABASE_URL="postgresql+psycopg://username:password@ep-your-project-id-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Groq AI Inference
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="qwen/qwen3.8-27b"
GROQ_MAX_TOKENS=800

# Authentication & Security
JWT_SECRET="your-secure-jwt-secret-key-here"
